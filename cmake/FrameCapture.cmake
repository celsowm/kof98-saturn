if(CMAKE_CROSSCOMPILING)
  message(FATAL_ERROR "Capture requires a native host compiler")
endif()
if(KOF_BUILD_HOST_ORACLE)
  message(FATAL_ERROR "Use a separate build from the paged oracle")
endif()
enable_language(CXX)
find_package(Python3 REQUIRED COMPONENTS Interpreter)
find_package(Git REQUIRED)
set(KOF_UPSTREAM_DIR "" CACHE PATH "Pinned KOF98 reference checkout")
get_filename_component(up "${KOF_UPSTREAM_DIR}" ABSOLUTE)
set(ng "${up}/neogeorecomp")
foreach(pair IN ITEMS "${up}|44f873a3cca3827a48fca30fa8091da746311af0" "${ng}|a47ee3fe09dc46d1f2b86c36ec972b43b35ebf62")
  string(REPLACE "|" ";" pair "${pair}")
  list(GET pair 0 dir)
  list(GET pair 1 expected)
  execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${dir}" rev-parse HEAD OUTPUT_VARIABLE sha OUTPUT_STRIP_TRAILING_WHITESPACE RESULT_VARIABLE rc)
  execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${dir}" diff --quiet HEAD -- RESULT_VARIABLE dirty)
  if(NOT rc STREQUAL "0" OR NOT sha STREQUAL expected OR NOT dirty STREQUAL "0")
    message(FATAL_ERROR "Expected clean pinned checkout: ${dir} at ${expected}")
  endif()
endforeach()
set(NEOGEORECOMP_BUILD_TESTS OFF CACHE BOOL "" FORCE)
set(CMAKE_DISABLE_FIND_PACKAGE_SDL2 ON)
add_subdirectory("${ng}" "${CMAKE_CURRENT_BINARY_DIR}/ng" EXCLUDE_FROM_ALL)
# Upstream platform.c uses MSVC's pragma comment(lib), ignored by MinGW.
if(WIN32)
  target_link_libraries(neogeorecomp PUBLIC dbghelp)
endif()
set(video "${CMAKE_CURRENT_BINARY_DIR}/capture_video.c")
execute_process(COMMAND "${Python3_EXECUTABLE}" "${PROJECT_SOURCE_DIR}/tools/instrument_frame.py" "${ng}/src/video.c" "${video}" RESULT_VARIABLE rc)
if(NOT rc STREQUAL "0")
  message(FATAL_ERROR "Frame instrumentation failed")
endif()
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${ng}/src/video.c" "${PROJECT_SOURCE_DIR}/tools/instrument_frame.py")
get_target_property(sources neogeorecomp SOURCES)
set(replaced "")
set(count 0)
foreach(src IN LISTS sources)
  get_filename_component(abs "${src}" ABSOLUTE BASE_DIR "${ng}")
  if(abs STREQUAL "${ng}/src/video.c")
    list(APPEND replaced "${video}")
    math(EXPR count "${count}+1")
  else()
    list(APPEND replaced "${abs}")
  endif()
endforeach()
if(NOT count EQUAL 1)
  message(FATAL_ERROR "Expected one video.c")
endif()
set_property(TARGET neogeorecomp PROPERTY SOURCES "${replaced}")
target_sources(neogeorecomp PRIVATE "${PROJECT_SOURCE_DIR}/src/host/frame_capture.c")
target_link_libraries(neogeorecomp PRIVATE kof_lspc_ir)
add_executable(kof_frame_capture "${up}/src/main.c" "${up}/src/game.c")
target_compile_definitions(kof_frame_capture PRIVATE KOF98_PLAYER)
target_link_libraries(kof_frame_capture PRIVATE neogeorecomp)
if(MSVC)
  target_compile_definitions(kof_frame_capture PRIVATE _CRT_SECURE_NO_WARNINGS)
endif()
