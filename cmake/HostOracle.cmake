# Optional local host integration. Never invoked by ROM-free CI or SH-2 builds.
if(CMAKE_CROSSCOMPILING)
  message(FATAL_ERROR "KOF_BUILD_HOST_ORACLE requires a native host compiler")
endif()
enable_language(CXX)
find_package(Python3 REQUIRED COMPONENTS Interpreter)
find_package(Git REQUIRED)
set(KOF_UPSTREAM_DIR "" CACHE PATH "Pinned upstream KOF98 checkout with initialized submodules")
set(KOF_ROM_DIR "" CACHE PATH "Local extracted AES and BIOS ROMs")
set(KOF_ENTRIES "" CACHE FILEPATH "Optional local upstream profiling entries")
if(NOT IS_DIRECTORY "${KOF_UPSTREAM_DIR}/neogeorecomp/ext/musashi" OR NOT IS_DIRECTORY "${KOF_ROM_DIR}")
  message(FATAL_ERROR "Set KOF_UPSTREAM_DIR and KOF_ROM_DIR")
endif()
get_filename_component(KOF_UPSTREAM_DIR "${KOF_UPSTREAM_DIR}" ABSOLUTE)
get_filename_component(KOF_ROM_DIR "${KOF_ROM_DIR}" ABSOLUTE)
set(ng "${KOF_UPSTREAM_DIR}/neogeorecomp")
function(kof_check_pin dir expected)
  execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${dir}" rev-parse HEAD
    RESULT_VARIABLE rc OUTPUT_VARIABLE actual OUTPUT_STRIP_TRAILING_WHITESPACE)
  if(NOT rc STREQUAL "0" OR NOT actual STREQUAL expected)
    message(FATAL_ERROR "Unexpected upstream revision in ${dir}: ${actual}; expected ${expected}")
  endif()
  execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${dir}" diff --quiet HEAD --
    RESULT_VARIABLE dirty)
  if(NOT dirty STREQUAL "0")
    message(FATAL_ERROR "Tracked upstream changes in ${dir}; use a clean pinned checkout")
  endif()
endfunction()
kof_check_pin("${KOF_UPSTREAM_DIR}" "44f873a3cca3827a48fca30fa8091da746311af0")
kof_check_pin("${ng}" "a47ee3fe09dc46d1f2b86c36ec972b43b35ebf62")

set(NEOGEORECOMP_BUILD_TESTS OFF CACHE BOOL "" FORCE)
add_subdirectory("${ng}" "${CMAKE_CURRENT_BINARY_DIR}/neogeorecomp" EXCLUDE_FROM_ALL)
# Replace just the desktop execution source. Keep the upstream checkout pristine.
set(gen "${CMAKE_CURRENT_BINARY_DIR}/generated")
file(MAKE_DIRECTORY "${gen}")
set(adapted "${gen}/exec_paged.c")
execute_process(COMMAND "${Python3_EXECUTABLE}" "${PROJECT_SOURCE_DIR}/tools/adapt_host_exec.py"
  "${ng}/src/exec.c" "${adapted}" RESULT_VARIABLE patch_rc)
if(NOT patch_rc STREQUAL "0")
  message(FATAL_ERROR "Pinned exec.c adaptation failed")
endif()
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
  "${ng}/src/exec.c" "${PROJECT_SOURCE_DIR}/tools/adapt_host_exec.py")
get_target_property(ng_sources neogeorecomp SOURCES)
set(replacement_sources "")
set(replaced 0)
foreach(src IN LISTS ng_sources)
  get_filename_component(abs "${src}" ABSOLUTE BASE_DIR "${ng}")
  if(abs STREQUAL "${ng}/src/exec.c")
    list(APPEND replacement_sources "${adapted}")
    math(EXPR replaced "${replaced}+1")
  else()
    list(APPEND replacement_sources "${abs}")
  endif()
endforeach()
if(NOT replaced EQUAL 1)
  message(FATAL_ERROR "Expected exactly one upstream exec.c source")
endif()
set_property(TARGET neogeorecomp PROPERTY SOURCES "${replacement_sources}")
target_link_libraries(neogeorecomp PRIVATE kof_dispatch)

add_executable(kof_local_recomp "${KOF_UPSTREAM_DIR}/src/recomp_main.c" "${KOF_UPSTREAM_DIR}/src/game.c")
target_link_libraries(kof_local_recomp PRIVATE m68krecomp_core)
set(routines "")
foreach(i RANGE 0 15)
  if(i LESS 10)
    set(part "0${i}")
  else()
    set(part "${i}")
  endif()
  list(APPEND routines "${gen}/recomp_${part}.c")
endforeach()
set(legacy "${gen}/recomp_table.c")
set(common "${gen}/recomp_common.h")
set(paged "${gen}/kof_paged_table.c")
set(entry_args "")
set(entry_dep "")
if(KOF_ENTRIES)
  get_filename_component(KOF_ENTRIES "${KOF_ENTRIES}" ABSOLUTE)
  if(NOT EXISTS "${KOF_ENTRIES}")
    message(FATAL_ERROR "KOF_ENTRIES does not exist")
  endif()
  set(entry_args --entries "${KOF_ENTRIES}")
  set(entry_dep "${KOF_ENTRIES}")
endif()
# Treat ROM input changes as build dependencies, not stale generated code.
file(GLOB rom_inputs CONFIGURE_DEPENDS "${KOF_ROM_DIR}/*.bin" "${KOF_ROM_DIR}/*.sfix" "${KOF_ROM_DIR}/*.sm1" "${KOF_ROM_DIR}/*.lo")
add_custom_command(OUTPUT ${routines} "${legacy}" "${common}"
  COMMAND $<TARGET_FILE:kof_local_recomp> --rom-path "${KOF_ROM_DIR}" --out "${gen}" --files 16 ${entry_args}
  DEPENDS kof_local_recomp ${entry_dep} ${rom_inputs} VERBATIM)
add_custom_command(OUTPUT "${paged}"
  COMMAND "${Python3_EXECUTABLE}" "${PROJECT_SOURCE_DIR}/tools/pack_dispatch.py" "${legacy}" "${paged}"
  DEPENDS "${legacy}" "${PROJECT_SOURCE_DIR}/tools/pack_dispatch.py" VERBATIM)
add_executable(kof_host_paged "${PROJECT_SOURCE_DIR}/src/host/paged_main.c"
  "${KOF_UPSTREAM_DIR}/src/game.c" ${routines} "${paged}" "${common}")
target_include_directories(kof_host_paged PRIVATE "${KOF_UPSTREAM_DIR}/src" "${gen}")
target_compile_definitions(kof_host_paged PRIVATE KOF98_PLAYER KOF98_ASSET_DIR="${KOF_UPSTREAM_DIR}/assets")
target_link_libraries(kof_host_paged PRIVATE neogeorecomp kof_dispatch)
if(MSVC)
  target_compile_options(kof_host_paged PRIVATE /bigobj /D_CRT_SECURE_NO_WARNINGS)
endif()
