#ifndef SH2_SHIM_MEMORY
#define SH2_SHIM_MEMORY
#include <stddef.h>
namespace std {
template<class T> class unique_ptr {
public:
    unique_ptr() : p(0) {}
    explicit unique_ptr(T* q) : p(q) {}
    ~unique_ptr() { delete p; }
    unique_ptr(unique_ptr&& o) : p(o.p) { o.p = 0; }
    unique_ptr& operator=(unique_ptr&& o) { if (this != &o) { delete p; p = o.p; o.p = 0; } return *this; }
    T& operator*() const { return *p; }
    T* operator->() const { return p; }
    T* get() const { return p; }
    explicit operator bool() const { return p != 0; }
    void reset(T* q = 0) { delete p; p = q; }
private:
    unique_ptr(const unique_ptr&);
    unique_ptr& operator=(const unique_ptr&);
    T* p;
};
template<class T, class... Args> unique_ptr<T> make_unique(Args&&... args) {
    return unique_ptr<T>(new T(static_cast<Args&&>(args)...));
}
}
#endif
